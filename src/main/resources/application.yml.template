spring:
  application:
    name: Blink

  datasource:
    url: ${DB_URL:jdbc:postgresql://localhost:5432/blinkdb}
    username: ${DB_USERNAME:user}
    password: ${DB_PASSWORD:pass}
    driver-class-name: org.postgresql.Driver

  jpa:
    hibernate:
      ddl-auto: validate
    show-sql: true

  servlet:
    multipart:
      max-file-size: 100MB
      max-request-size: 100MB

  data:
    redis:
      host: localhost
      port: 6379

  docker:
    compose:
      enabled: true
      lifecycle-management: start_only
      readiness:
        wait: always

minio:
  url: ${MINIO_URL:http://localhost:9000}
  access-key: ${MINIO_ACCESS_KEY:minioadmin}
  secret-key: ${MINIO_SECRET_KEY:minioadmin}
  bucket-name: ${MINIO_BUCKET_NAME:storage-bucket}

security:
  jwt:
    secret-key: ${JWT_SECRET:placeholder_for_development_only}
    expiration: 86400000 # milliseconds (24h)

management:
  server:
    port: 8081
  endpoints:
    web:
      exposure:
        include: health, info, prometheus, metrics
  endpoint:
    health:
      show-details: when_authorized
  prometheus:
    metrics:
      export:
        enabled: true

blink:
  retention-period-hours: 24
  rate-limit:
    upload:
      requests: 10
      window-seconds: 60
    download:
      requests: 30
      window-seconds: 60